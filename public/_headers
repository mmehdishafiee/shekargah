# Cloudflare Pages response headers.
#
# If the build is ever configured with `assetShards` (see vite.config.ts), those
# origins must also be listed on script-src/style-src/font-src/connect-src — the
# shards are alternate ports of this same hostname, so `https://shekargaah.ir:*`
# covers them. If you later move Supabase to a custom domain, add it to
# img-src/connect-src.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
