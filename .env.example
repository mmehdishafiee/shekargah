# Copy this file to `.env.local` and fill in values from your Supabase dashboard
# (Project Settings → API). Both values are PUBLIC client values and safe to ship
# to the browser — row level security protects the data.
#
# NEVER put the service_role key or the database password here.
#
# Leave both empty to run Shekargah in demo mode (browser-only sample data).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: public URL of the source repository, shown in the footer.
VITE_REPOSITORY_URL=
