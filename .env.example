# Copy this file to `.env.local` and fill in values from your Supabase dashboard
# (Project Settings → API). Both values are PUBLIC client values and safe to ship
# to the browser — row level security protects the data.
#
# NEVER put the service_role key or the database password here.
#
# REQUIRED: the app will not start without both values. There is no demo mode —
# every page only ever shows real Supabase data.
#
# Give the direct project URL (`https://<ref>.supabase.co`). The production build
# rewrites it to this site's own `/api/supabase`, which a Cloudflare Pages
# Function forwards upstream — Iranian networks route direct Supabase traffic
# through slow, variable relays. Build with `VITE_SUPABASE_PROXY=off` to skip
# the proxy and talk to Supabase directly again.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: public URL of the source repository, shown in the footer.
VITE_REPOSITORY_URL=

# Optional: override the public site URL (canonical links, sitemap, feed, robots).
# The committed default lives in `site.config.json`; only set this for previews
# or tests. Change the real domain with: npm run domain -- <new-domain>
VITE_SITE_URL=

# Optional: Cloudflare Worker that powers "ورود با تلگرام".
# Leave empty to hide the Telegram sign-in button entirely.
# Example: https://shekargah-bot.<subdomain>.workers.dev
VITE_TELEGRAM_BOT_URL=
VITE_TELEGRAM_BOT_USERNAME=
